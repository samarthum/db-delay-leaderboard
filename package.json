    "satori": "0.63.2"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
