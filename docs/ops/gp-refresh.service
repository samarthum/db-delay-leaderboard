[Unit]
Description=German Punctuality weekly refresh (trains from abroad)
[Service]
Type=oneshot
# Copy docs/ops/refresh.sh to ~/gp-refresh/refresh.sh, put DB_CLIENT_ID=/DB_API_KEY= lines in ~/gp-refresh/db.env (0600),
# and make sure node >= 20 and git with push rights work for this user.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/gp-refresh/refresh.sh
MemoryMax=600M
TimeoutStartSec=3600
